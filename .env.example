# Copy this to .env and fill in your values
# NEVER commit .env to git

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Random long string used to sign the PKCE + token cookies (e.g. `openssl rand -hex 32`)
OAUTH_COOKIE_SECRET=your_random_secret_here

# Must exactly match the URI whitelisted with Swiggy Builders Club
SWIGGY_REDIRECT_URI=https://fitorder.netlify.app/api/auth/callback/swiggy

# Optional — only set this if you want to pin a specific client_id instead of
# letting the app register itself with Swiggy via Dynamic Client Registration.
# SWIGGY_CLIENT_ID=
